# Public site URL (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://largis.co

# Supabase — leave blank to run the site without a database.
# When unset, contact submissions are not stored (email alerts still work if Resend is set).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — emails every contact submission to the team.
RESEND_API_KEY=
# Where enquiry alerts are delivered (defaults to sagar@largis.co).
CONTACT_NOTIFY_EMAIL=
# Sender on a domain verified in Resend, e.g. "Largis Venture <hello@largis.co>".
# Until set, alerts go out from onboarding@resend.dev (delivered only to the Resend
# account owner's address) and the visitor auto-reply is skipped.
CONTACT_FROM_EMAIL=

# Cal.com booking link path (the part after cal.com/), e.g. largis/consultation.
# Build-time variable: redeploy after changing it.
NEXT_PUBLIC_CAL_LINK=
