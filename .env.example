# Public site URL (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=https://largis.co

# Supabase — leave blank to run the site without a database.
# When unset, contact submissions are not stored (email alerts still work if Resend is set).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER-ONLY: never prefix with NEXT_PUBLIC_ or expose to the browser.
# Required for portal sign-in (checks who is invited, creates invited accounts, applies invitations).
# Until set, /api/auth/otp/send returns 503 and the sign-in pages show a "being set up" notice.
SUPABASE_SECRET_KEY=

# Portal hostnames (no protocol). Defaults shown. Locally, app.localhost:3000 and
# workspace.localhost:3000 are recognised automatically without setting these.
NEXT_PUBLIC_PORTAL_HOST=app.largis.co
NEXT_PUBLIC_WORKSPACE_HOST=workspace.largis.co

# Resend — emails every contact submission to the team.
RESEND_API_KEY=
# Where enquiry alerts are delivered (defaults to sagar@largis.co).
CONTACT_NOTIFY_EMAIL=
# Sender on a domain verified in Resend, e.g. "Largis Venture <hello@largis.co>".
# Until set, alerts go out from onboarding@resend.dev (delivered only to the Resend
# account owner's address) and the visitor auto-reply is skipped.
CONTACT_FROM_EMAIL=

# Payment instructions printed on invoice PDFs (bank name, account number, IFSC, UPI ID).
# Until set, invoices say bank details come from the Largis account manager.
BILLING_PAYMENT_INSTRUCTIONS=

# Cal.com booking link path (the part after cal.com/), e.g. largis/consultation.
# Build-time variable: redeploy after changing it.
NEXT_PUBLIC_CAL_LINK=
